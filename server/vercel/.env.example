# Copy to .env.local for `vercel dev`; never commit real values.
AI_API_KEY=REPLACE_WITH_YOUR_OPENAI_COMPATIBLE_API_KEY
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=60000
ALLOWED_ORIGINS=https://htfyu.github.io,http://localhost:5598,http://127.0.0.1:5598,http://localhost:3000,http://127.0.0.1:3000
# Optional proxy access gate (NOT the model API key). Leave empty to disable.
ACCESS_TOKEN=